# --- Настройки Веб-Сервера LiveAtlas ---
PORT=8082

# Тип хранилища тайлов: filetree, db или s3
STORAGE_TYPE=db

# Абсолютный путь к папке dynmap на вашем сервере (откуда читать конфиги/апдейты игроков)
DYNMAP_DIR=/home/bve/LiveAtlas/standalone

# --- Настройки подключения к Базе Данных ---
# (Требуются, если STORAGE_TYPE=db или если используется БД для авторизации/регистрации пользователей)
DB_TYPE=mysql            # Возможные типы: mysql, mariadb, postgres
DB_HOST=127.0.0.1        # Адрес сервера БД
DB_PORT=3306             # Порт (3306 для MySQL/MariaDB, 5432 для PostgreSQL)
DB_USER=dynmap             # Имя пользователя БД
DB_PASSWORD=ZKns8te8jX8jWVUdQahJqsyyLyp4gTSG     # Пароль пользователя БД
DB_NAME=dynmap_db        # Название базы данных
DB_PREFIX=	         # Префикс таблиц (обычно dynmap_ или пусто)

# --- Настройки подключения к S3-совместимому хранилищу ---
# (Требуются, только если STORAGE_TYPE=s3)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=my-dynmap-tiles-bucket
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_PATH_PREFIX=tiles/
